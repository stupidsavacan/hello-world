[{"id":"leap-1","moduleId":"leap","prompt":"agree","explanation":"I totally agree with this opinion.","category":"意見・主張・提案","type":"input","answer":"賛成する","acceptableAnswers":["賛成する","同意する","意見が一致する"],"direction":"normal"},{"id":"leap-2","moduleId":"leap","prompt":"oppose","explanation":"I strongly oppose the plan.","category":"意見・主張・提案","type":"input","answer":"反対する","acceptableAnswers":["反対する"],"direction":"normal"},{"id":"leap-3","moduleId":"leap","prompt":"advise","explanation":"The doctor advised him not to eat too much.","category":"意見・主張・提案","type":"input","answer":"忠告する","acceptableAnswers":["忠告する","助言する"],"direction":"normal"},{"id":"leap-4","moduleId":"leap","prompt":"tip","explanation":"Do you have any tips on how to use the library?","category":"意見・主張・提案","type":"input","answer":"助言","acceptableAnswers":["助言","ヒント","チップ","先端"],"direction":"normal"},{"id":"leap-5","moduleId":"leap","prompt":"discuss","explanation":"I discussed the problem with a specialist.","category":"意見・主張・提案","type":"input","answer":"話し合う","acceptableAnswers":["話し合う","議論する"],"direction":"normal"},{"id":"leap-6","moduleId":"leap","prompt":"blame","explanation":"He blamed the car's brakes for the accident.","category":"意見・主張・提案","type":"input","answer":"責める","acceptableAnswers":["責める","非難する"],"direction":"normal"},{"id":"leap-7","moduleId":"leap","prompt":"argue","explanation":"I argue that reading aloud is important.","category":"意見・主張・提案","type":"input","answer":"主張する","acceptableAnswers":["主張する","議論する","言い争う"],"direction":"normal"},{"id":"leap-8","moduleId":"leap","prompt":"claim","explanation":"She claims that a vegetarian diet is better.","category":"感謝・謝罪","type":"input","answer":"主張する","acceptableAnswers":["主張する","要求する","請求する","主張"],"direction":"normal"},{"id":"leap-9","moduleId":"leap","prompt":"complain","explanation":"They complain about their loud music.","category":"感謝・謝罪","type":"input","answer":"不平を言う","acceptableAnswers":["不平を言う","苦情を言う","訴える"],"direction":"normal"},{"id":"leap-10","moduleId":"leap","prompt":"offer","explanation":"He offered him some coffee.","category":"感謝・謝罪","type":"input","answer":"申し出る","acceptableAnswers":["申し出る","提供する","申し出"],"direction":"normal"},{"id":"leap-11","moduleId":"leap","prompt":"suggest","explanation":"The letter suggests that she is willing to accept the job.","category":"感謝・謝罪","type":"input","answer":"提案する","acceptableAnswers":["提案する","示唆する","暗示する"],"direction":"normal"},{"id":"leap-12","moduleId":"leap","prompt":"recommend","explanation":"What would you recommend?","category":"感謝・謝罪","type":"input","answer":"推薦する","acceptableAnswers":["推薦する","勧める"],"direction":"normal"},{"id":"leap-13","moduleId":"leap","prompt":"grateful","explanation":"I am grateful for your help.","category":"感謝・謝罪","type":"input","answer":"感謝している","acceptableAnswers":["感謝している"],"direction":"normal"},{"id":"leap-14","moduleId":"leap","prompt":"apologize","explanation":"I apologize to her for being late.","category":"感謝・謝罪","type":"input","answer":"謝る","acceptableAnswers":["謝る","謝罪する"],"direction":"normal"},{"id":"leap-15","moduleId":"leap","prompt":"excuse","explanation":"Don't make excuses.","category":"祝福・賞賛・説明","type":"input","answer":"許す","acceptableAnswers":["許す","言い訳","弁解"],"direction":"normal"},{"id":"leap-16","moduleId":"leap","prompt":"celebrate","explanation":"We celebrate her 18th birthday.","category":"祝福・賞賛・説明","type":"input","answer":"祝う","acceptableAnswers":["祝う","祝賀する"],"direction":"normal"},{"id":"leap-17","moduleId":"leap","prompt":"congratulate","explanation":"I congratulate her on her exam results.","category":"祝福・賞賛・説明","type":"input","answer":"祝う","acceptableAnswers":["祝う","祝辞を述べる"],"direction":"normal"},{"id":"leap-18","moduleId":"leap","prompt":"admire","explanation":"I admire him for his great performance.","category":"祝福・賞賛・説明","type":"input","answer":"称賛する","acceptableAnswers":["称賛する","敬服する"],"direction":"normal"},{"id":"leap-19","moduleId":"leap","prompt":"impress","explanation":"I was deeply impressed by his speech.","category":"祝福・賞賛・説明","type":"input","answer":"印象を与える","acceptableAnswers":["印象を与える","感動させる"],"direction":"normal"},{"id":"leap-20","moduleId":"leap","prompt":"award","explanation":"She was awarded first prize.","category":"祝福・賞賛・説明","type":"input","answer":"賞","acceptableAnswers":["賞","賞を授与する"],"direction":"normal"}]