[{"id":"chemistry-chem121","moduleId":"chemistry","prompt":"ろ過でろ紙の上に残るものはどれか。","explanation":"ろ紙の上に残った固体を残留物という。","category":"分離・精製","type":"choice","choices":["残留物","ろ液","蒸留物","抽出液"],"answer":"残留物","acceptableAnswers":["残留物"]},{"id":"chemistry-chem122","moduleId":"chemistry","prompt":"炎色反応でリチウムLiが示す代表的な色は何色か。","explanation":"Liは赤色系の炎色反応を示す。","category":"元素と検出","type":"choice","choices":["赤色","黄色","赤紫色","青緑色"],"answer":"赤色","acceptableAnswers":["赤色","赤"]},{"id":"chemistry-chem123","moduleId":"chemistry","prompt":"炎色反応でストロンチウムSrが示す代表的な色は何色か。","explanation":"Srは紅色系の炎色反応を示す。","category":"元素と検出","type":"choice","choices":["紅色","黄色","黄緑色","青緑色"],"answer":"紅色","acceptableAnswers":["紅色","赤色"]},{"id":"chemistry-chem124","moduleId":"chemistry","prompt":"炎色反応でバリウムBaが示す代表的な色は何色か。","explanation":"Baは黄緑色の炎色反応を示す。","category":"元素と検出","type":"choice","choices":["黄緑色","黄色","赤紫色","橙赤色"],"answer":"黄緑色","acceptableAnswers":["黄緑色"]},{"id":"chemistry-chem125","moduleId":"chemistry","prompt":"白金線などに試料をつけて炎に入れ、元素特有の色を見る実験を何というか。","explanation":"金属元素の確認に利用される。","category":"元素と検出","type":"choice","choices":["炎色反応","沈殿反応","中和反応","酸化反応"],"answer":"炎色反応","acceptableAnswers":["炎色反応"]},{"id":"chemistry-chem126","moduleId":"chemistry","prompt":"二酸化炭素を石灰水に通すと白くにごるのは、主に何が生じるためか。","explanation":"二酸化炭素と石灰水中の成分が反応して白色沈殿を生じる。","category":"元素と検出","type":"choice","choices":["炭酸カルシウム","塩化銀","硫酸銅","水酸化ナトリウム"],"answer":"炭酸カルシウム","acceptableAnswers":["炭酸カルシウム","CaCO3"]},{"id":"chemistry-chem127","moduleId":"chemistry","prompt":"水の検出に使い、水があると白色から青色に変わる物質は何か。","explanation":"無水硫酸銅は水を含むと青色になる。","category":"元素と検出","type":"choice","choices":["無水硫酸銅","塩化コバルト紙","石灰水","硝酸銀水溶液"],"answer":"無水硫酸銅","acceptableAnswers":["無水硫酸銅","硫酸銅(II)無水物","硫酸銅無水物"]},{"id":"chemistry-chem128","moduleId":"chemistry","prompt":"亜鉛の元素記号はどれか。","explanation":"亜鉛はZn。","category":"電子配置と周期表","type":"choice","choices":["Zn","Zr","Cu","Ag"],"answer":"Zn","acceptableAnswers":["Zn"]},{"id":"chemistry-chem129","moduleId":"chemistry","prompt":"白金の元素記号はどれか。","explanation":"白金はPt。","category":"電子配置と周期表","type":"choice","choices":["Pt","Pb","P","Fe"],"answer":"Pt","acceptableAnswers":["Pt"]},{"id":"chemistry-chem130","moduleId":"chemistry","prompt":"クロムの元素記号はどれか。","explanation":"クロムはCr。","category":"電子配置と周期表","type":"choice","choices":["Cr","Cl","Cu","Ca"],"answer":"Cr","acceptableAnswers":["Cr"]},{"id":"chemistry-chem131","moduleId":"chemistry","prompt":"マンガンの元素記号はどれか。","explanation":"マンガンはMn。","category":"電子配置と周期表","type":"choice","choices":["Mn","Mg","Mo","Na"],"answer":"Mn","acceptableAnswers":["Mn"]},{"id":"chemistry-chem132","moduleId":"chemistry","prompt":"臭素の元素記号はどれか。","explanation":"臭素はBr。","category":"電子配置と周期表","type":"choice","choices":["Br","B","Ba","Be"],"answer":"Br","acceptableAnswers":["Br"]},{"id":"chemistry-chem133","moduleId":"chemistry","prompt":"ヨウ素の元素記号はどれか。","explanation":"ヨウ素はI。","category":"電子配置と周期表","type":"choice","choices":["I","Y","In","Ir"],"answer":"I","acceptableAnswers":["I"]},{"id":"chemistry-chem134","moduleId":"chemistry","prompt":"アルミニウムの元素記号はどれか。","explanation":"アルミニウムはAl。","category":"電子配置と周期表","type":"choice","choices":["Al","Ag","Au","Ar"],"answer":"Al","acceptableAnswers":["Al"]},{"id":"chemistry-chem135","moduleId":"chemistry","prompt":"マグネシウムの元素記号はどれか。","explanation":"マグネシウムはMg。","category":"電子配置と周期表","type":"choice","choices":["Mg","Mn","Na","Ne"],"answer":"Mg","acceptableAnswers":["Mg"]},{"id":"chemistry-chem136","moduleId":"chemistry","prompt":"窒素の元素記号はどれか。","explanation":"窒素はN。","category":"電子配置と周期表","type":"choice","choices":["N","Na","Ne","Ni"],"answer":"N","acceptableAnswers":["N"]},{"id":"chemistry-chem137","moduleId":"chemistry","prompt":"ネオンの元素記号はどれか。","explanation":"ネオンはNe。","category":"電子配置と周期表","type":"choice","choices":["Ne","Na","N","Ni"],"answer":"Ne","acceptableAnswers":["Ne"]},{"id":"chemistry-chem138","moduleId":"chemistry","prompt":"ベリリウムの元素記号はどれか。","explanation":"ベリリウムはBe。","category":"電子配置と周期表","type":"choice","choices":["Be","B","Ba","Br"],"answer":"Be","acceptableAnswers":["Be"]},{"id":"chemistry-chem139","moduleId":"chemistry","prompt":"ホウ素の元素記号はどれか。","explanation":"ホウ素はB。","category":"電子配置と周期表","type":"choice","choices":["B","Be","Ba","Br"],"answer":"B","acceptableAnswers":["B"]},{"id":"chemistry-chem140","moduleId":"chemistry","prompt":"2族元素を何というか。","explanation":"周期表の2族はアルカリ土類金属として扱う。","category":"電子配置と周期表","type":"choice","choices":["アルカリ土類金属","アルカリ金属","ハロゲン","希ガス"],"answer":"アルカリ土類金属","acceptableAnswers":["アルカリ土類金属"]}]