[{"id":"chemistry-chem101","moduleId":"chemistry","prompt":"塩素原子Clが電子を1個受け取るとできるイオンは何か。","explanation":"Cl-になる。","category":"イオン","type":"choice","choices":["塩化物イオン","ナトリウムイオン","水素イオン","水酸化物イオン"],"answer":"塩化物イオン","acceptableAnswers":["塩化物イオン","Cl-"]},{"id":"chemistry-chem102","moduleId":"chemistry","prompt":"マグネシウム原子Mgが電子を2個失うとできるイオンは何か。","explanation":"Mg2+になる。","category":"イオン","type":"choice","choices":["マグネシウムイオン","カルシウムイオン","ナトリウムイオン","塩化物イオン"],"answer":"マグネシウムイオン","acceptableAnswers":["マグネシウムイオン","Mg2+"]},{"id":"chemistry-chem103","moduleId":"chemistry","prompt":"カルシウム原子Caが電子を2個失うとできるイオンは何か。","explanation":"Ca2+になる。","category":"イオン","type":"choice","choices":["カルシウムイオン","マグネシウムイオン","水素イオン","酸化物イオン"],"answer":"カルシウムイオン","acceptableAnswers":["カルシウムイオン","Ca2+"]},{"id":"chemistry-chem104","moduleId":"chemistry","prompt":"酸素原子Oが電子を2個受け取るとできるイオンは何か。","explanation":"O2-になる。","category":"イオン","type":"choice","choices":["酸化物イオン","塩化物イオン","硝酸イオン","硫酸イオン"],"answer":"酸化物イオン","acceptableAnswers":["酸化物イオン","O2-"]},{"id":"chemistry-chem105","moduleId":"chemistry","prompt":"水素原子Hが電子を1個失うとできるイオンは何か。","explanation":"H+になる。","category":"イオン","type":"choice","choices":["水素イオン","水酸化物イオン","塩化物イオン","アンモニウムイオン"],"answer":"水素イオン","acceptableAnswers":["水素イオン","H+"]},{"id":"chemistry-chem106","moduleId":"chemistry","prompt":"水酸化物イオンのイオン式はどれか。","explanation":"水酸化物イオンはOH-。","category":"イオン","type":"choice","choices":["OH-","NO3-","SO4^2-","NH4+"],"answer":"OH-","acceptableAnswers":["OH-"]},{"id":"chemistry-chem107","moduleId":"chemistry","prompt":"硝酸イオンのイオン式はどれか。","explanation":"硝酸イオンはNO3-。","category":"イオン","type":"choice","choices":["NO3-","OH-","SO4^2-","CO3^2-"],"answer":"NO3-","acceptableAnswers":["NO3-"]},{"id":"chemistry-chem108","moduleId":"chemistry","prompt":"硫酸イオンのイオン式はどれか。","explanation":"硫酸イオンはSO4^2-。","category":"イオン","type":"choice","choices":["SO4^2-","NO3-","CO3^2-","NH4+"],"answer":"SO4^2-","acceptableAnswers":["SO4^2-"]},{"id":"chemistry-chem109","moduleId":"chemistry","prompt":"炭酸イオンのイオン式はどれか。","explanation":"炭酸イオンはCO3^2-。","category":"イオン","type":"choice","choices":["CO3^2-","NO3-","SO4^2-","OH-"],"answer":"CO3^2-","acceptableAnswers":["CO3^2-"]},{"id":"chemistry-chem110","moduleId":"chemistry","prompt":"アンモニウムイオンのイオン式はどれか。","explanation":"アンモニウムイオンはNH4+。","category":"イオン","type":"choice","choices":["NH4+","OH-","NO3-","CO3^2-"],"answer":"NH4+","acceptableAnswers":["NH4+"]},{"id":"chemistry-chem111","moduleId":"chemistry","prompt":"原子から電子1個を取り去って陽イオンにするのに必要なエネルギーを何というか。","explanation":"値が小さいほど陽イオンになりやすい。","category":"イオン","type":"choice","choices":["イオン化エネルギー","電子親和力","活性化エネルギー","結合エネルギー"],"answer":"イオン化エネルギー","acceptableAnswers":["イオン化エネルギー"]},{"id":"chemistry-chem112","moduleId":"chemistry","prompt":"原子が電子1個を受け取って陰イオンになるときに放出されるエネルギーを何というか。","explanation":"値が大きいほど電子を受け取りやすい傾向。","category":"イオン","type":"choice","choices":["電子親和力","イオン化エネルギー","活性化エネルギー","熱エネルギー"],"answer":"電子親和力","acceptableAnswers":["電子親和力"]},{"id":"chemistry-chem113","moduleId":"chemistry","prompt":"金属元素は陽イオンと陰イオンのどちらになりやすいか。","explanation":"金属元素は電子を失いやすい。","category":"イオン","type":"choice","choices":["陽イオン","陰イオン","同位体","分子"],"answer":"陽イオン","acceptableAnswers":["陽イオン"]},{"id":"chemistry-chem114","moduleId":"chemistry","prompt":"非金属元素は陽イオンと陰イオンのどちらになりやすいか。","explanation":"非金属元素は電子を受け取りやすい。","category":"イオン","type":"choice","choices":["陰イオン","陽イオン","単体","同素体"],"answer":"陰イオン","acceptableAnswers":["陰イオン"]},{"id":"chemistry-chem115","moduleId":"chemistry","prompt":"塩化ナトリウムNaClは、Na+と何からできているか。","explanation":"塩化ナトリウムはNa+とCl-からなる。","category":"イオン","type":"choice","choices":["Cl-","Na+","Mg2+","OH-"],"answer":"Cl-","acceptableAnswers":["Cl-","塩化物イオン"]},{"id":"chemistry-chem116","moduleId":"chemistry","prompt":"陽イオンと陰イオンの間にはどのような力が働くか。","explanation":"正と負の電荷は引き合う。","category":"イオン","type":"choice","choices":["引き合う力","反発する力","重力だけ","力は働かない"],"answer":"引き合う力","acceptableAnswers":["引き合う力","静電気的な引力"]},{"id":"chemistry-chem117","moduleId":"chemistry","prompt":"固体が液体を経ずに直接気体になる性質を利用して分離する方法は何か。","explanation":"ヨウ素やナフタレンなど、昇華しやすい物質の分離に使う。","category":"分離・精製","type":"choice","choices":["昇華法","蒸留","ろ過","再結晶"],"answer":"昇華法","acceptableAnswers":["昇華法","昇華"]},{"id":"chemistry-chem118","moduleId":"chemistry","prompt":"液体空気から窒素や酸素を分けるときに使う操作は何か。","explanation":"液体窒素と液体酸素は沸点が異なるため、分留で分けられる。","category":"分離・精製","type":"choice","choices":["分留","ろ過","再結晶","抽出"],"answer":"分留","acceptableAnswers":["分留","分別蒸留"]},{"id":"chemistry-chem119","moduleId":"chemistry","prompt":"固体が液体を経ずに気体へ変化し、さらに冷えて固体に戻る性質を何というか。","explanation":"ヨウ素、ドライアイス、ナフタレンなどで扱う。","category":"分離・精製","type":"choice","choices":["昇華","融解","凝固","凝縮"],"answer":"昇華","acceptableAnswers":["昇華"]},{"id":"chemistry-chem120","moduleId":"chemistry","prompt":"ろ過でろ紙の穴を通るものはどれか。","explanation":"ろ紙を通り抜けた液体をろ液という。","category":"分離・精製","type":"choice","choices":["ろ液","残留物","沈殿","結晶"],"answer":"ろ液","acceptableAnswers":["ろ液"]}]