[{"id":"chemistry-chem001","moduleId":"chemistry","prompt":"1種類の物質だけからできている物質を何というか。","explanation":"水や酸素など、1種類の物質として扱えるもの。","category":"物質の分類","type":"choice","choices":["純物質","混合物","単体","化合物"],"answer":"純物質","acceptableAnswers":["純物質"]},{"id":"chemistry-chem002","moduleId":"chemistry","prompt":"2種類以上の物質が混ざり合ったものを何というか。","explanation":"空気や食塩水のように、複数の物質が混ざったもの。","category":"物質の分類","type":"choice","choices":["混合物","純物質","単体","化合物"],"answer":"混合物","acceptableAnswers":["混合物"]},{"id":"chemistry-chem003","moduleId":"chemistry","prompt":"1種類の元素からなる純物質を何というか。","explanation":"酸素O2や鉄Feのように、1種類の元素だけでできた物質。","category":"物質の分類","type":"choice","choices":["単体","化合物","混合物","同位体"],"answer":"単体","acceptableAnswers":["単体"]},{"id":"chemistry-chem004","moduleId":"chemistry","prompt":"2種類以上の元素からなる純物質を何というか。","explanation":"水H2Oや塩化ナトリウムNaClのような物質。","category":"物質の分類","type":"choice","choices":["化合物","単体","混合物","同素体"],"answer":"化合物","acceptableAnswers":["化合物"]},{"id":"chemistry-chem005","moduleId":"chemistry","prompt":"同じ元素からできているが性質の異なる単体どうしを何というか。","explanation":"酸素とオゾン、ダイヤモンドと黒鉛など。","category":"物質の分類","type":"choice","choices":["同素体","同位体","化合物","混合物"],"answer":"同素体","acceptableAnswers":["同素体"]},{"id":"chemistry-chem006","moduleId":"chemistry","prompt":"酸素O2は単体と化合物のどちらか。","explanation":"酸素元素だけからできているので単体。","category":"物質の分類","type":"choice","choices":["単体","化合物","混合物","同素体"],"answer":"単体","acceptableAnswers":["単体"]},{"id":"chemistry-chem007","moduleId":"chemistry","prompt":"水H2Oは単体と化合物のどちらか。","explanation":"水素と酸素の2種類の元素からできている。","category":"物質の分類","type":"choice","choices":["化合物","単体","混合物","同素体"],"answer":"化合物","acceptableAnswers":["化合物"]},{"id":"chemistry-chem008","moduleId":"chemistry","prompt":"空気は純物質と混合物のどちらか。","explanation":"窒素、酸素、二酸化炭素などが混ざっている。","category":"物質の分類","type":"choice","choices":["混合物","純物質","単体","化合物"],"answer":"混合物","acceptableAnswers":["混合物"]},{"id":"chemistry-chem009","moduleId":"chemistry","prompt":"食塩水は純物質と混合物のどちらか。","explanation":"水と塩化ナトリウムが混ざっている。","category":"物質の分類","type":"choice","choices":["混合物","純物質","単体","化合物"],"answer":"混合物","acceptableAnswers":["混合物"]},{"id":"chemistry-chem010","moduleId":"chemistry","prompt":"炭素Cの同素体の例として適切なものはどれか。","explanation":"ダイヤモンドと黒鉛は炭素の同素体。","category":"物質の分類","type":"choice","choices":["ダイヤモンド","水","塩化ナトリウム","アンモニア"],"answer":"ダイヤモンド","acceptableAnswers":["ダイヤモンド"]},{"id":"chemistry-chem011","moduleId":"chemistry","prompt":"酸素Oの同素体の例として適切なものはどれか。","explanation":"酸素O2とオゾンO3は酸素の同素体。","category":"物質の分類","type":"choice","choices":["オゾン","水素","窒素","塩素"],"answer":"オゾン","acceptableAnswers":["オゾン"]},{"id":"chemistry-chem012","moduleId":"chemistry","prompt":"硫黄の元素記号はどれか。","explanation":"硫黄はS。","category":"物質の分類","type":"choice","choices":["S","C","O","P"],"answer":"S","acceptableAnswers":["S"]},{"id":"chemistry-chem013","moduleId":"chemistry","prompt":"炭素の元素記号はどれか。","explanation":"炭素はC。Caはカルシウム、Cuは銅、Clは塩素。","category":"物質の分類","type":"choice","choices":["C","Ca","Cu","Cl"],"answer":"C","acceptableAnswers":["C"]},{"id":"chemistry-chem014","moduleId":"chemistry","prompt":"リンの元素記号はどれか。","explanation":"リンはP。","category":"物質の分類","type":"choice","choices":["P","Pb","Pt","K"],"answer":"P","acceptableAnswers":["P"]},{"id":"chemistry-chem015","moduleId":"chemistry","prompt":"鉄の元素記号はどれか。","explanation":"鉄はFe。","category":"物質の分類","type":"choice","choices":["Fe","F","Fr","Au"],"answer":"Fe","acceptableAnswers":["Fe"]},{"id":"chemistry-chem016","moduleId":"chemistry","prompt":"ナトリウムの元素記号はどれか。","explanation":"ナトリウムはNa。","category":"物質の分類","type":"choice","choices":["Na","N","Ne","Ni"],"answer":"Na","acceptableAnswers":["Na"]},{"id":"chemistry-chem017","moduleId":"chemistry","prompt":"塩素の元素記号はどれか。","explanation":"塩素はCl。","category":"物質の分類","type":"choice","choices":["Cl","C","Ca","Cu"],"answer":"Cl","acceptableAnswers":["Cl"]},{"id":"chemistry-chem018","moduleId":"chemistry","prompt":"銀の元素記号はどれか。","explanation":"銀はAg。","category":"物質の分類","type":"choice","choices":["Ag","Au","Al","Ar"],"answer":"Ag","acceptableAnswers":["Ag"]},{"id":"chemistry-chem019","moduleId":"chemistry","prompt":"銅の元素記号はどれか。","explanation":"銅はCu。","category":"物質の分類","type":"choice","choices":["Cu","Cl","Ca","C"],"answer":"Cu","acceptableAnswers":["Cu"]},{"id":"chemistry-chem020","moduleId":"chemistry","prompt":"金の元素記号はどれか。","explanation":"金はAu。","category":"物質の分類","type":"choice","choices":["Au","Ag","Al","Ar"],"answer":"Au","acceptableAnswers":["Au"]}]
