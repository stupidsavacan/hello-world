[{"id":"english_comm-engc001","moduleId":"english_comm","prompt":"invention の意味は？","explanation":"inventは「発明する」、inventionは名詞で「発明」。","category":"Switch2単語","type":"choice","choices":["発明","配達","国際的な","反応"],"answer":"発明","acceptableAnswers":["発明"]},{"id":"english_comm-engc002","moduleId":"english_comm","prompt":"deliver の意味は？","explanation":"The post office delivered the letter. の deliver。","category":"Switch2単語","type":"choice","choices":["〜を配達する","〜を組織する","〜を減らす","〜を受け取る"],"answer":"〜を配達する","acceptableAnswers":["〜を配達する"]},{"id":"english_comm-engc003","moduleId":"english_comm","prompt":"educational の意味は？","explanation":"educationは「教育」、educationalは形容詞。","category":"Switch2単語","type":"choice","choices":["教育の","国際的な","正常な","医学の"],"answer":"教育の","acceptableAnswers":["教育の"]},{"id":"english_comm-engc004","moduleId":"english_comm","prompt":"rescue の意味は？","explanation":"animal rescue group は「動物救護団体」。","category":"Switch2単語","type":"choice","choices":["救助、救護","発明","利点","脳"],"answer":"救助、救護","acceptableAnswers":["救助、救護"]},{"id":"english_comm-engc005","moduleId":"english_comm","prompt":"emergency の意味は？","explanation":"Pet First Aid で緊急時の対応を扱う。","category":"Switch2単語","type":"choice","choices":["緊急時、非常事態","通常","午後","入門"],"answer":"緊急時、非常事態","acceptableAnswers":["緊急時、非常事態"]},{"id":"english_comm-engc006","moduleId":"english_comm","prompt":"normal の意味は？","explanation":"It is a normal reaction. の normal。","category":"Switch2単語","type":"choice","choices":["正常な","眠って","国際的な","教育の"],"answer":"正常な","acceptableAnswers":["正常な"]},{"id":"english_comm-engc007","moduleId":"english_comm","prompt":"reaction の意味は？","explanation":"食後の眠気は normal reaction。","category":"Switch2単語","type":"choice","choices":["反応","利点","郵便","趣味"],"answer":"反応","acceptableAnswers":["反応"]},{"id":"english_comm-engc008","moduleId":"english_comm","prompt":"benefit の意味は？","explanation":"The first benefit of napping の benefit。","category":"Switch2単語","type":"choice","choices":["利点","脳","睡眠パターン","非常時"],"answer":"利点","acceptab