[{"id":"geography-047","moduleId":"geography","prompt":"河川の側方への侵食で谷底が広がり，さらに土砂の堆積によって形成された谷間の平野を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["谷底平野","堆積平野","沖積平野","V字谷"],"answer":"谷底平野","acceptableAnswers":["谷底平野"]},{"id":"geography-048","moduleId":"geography","prompt":"河川の流路に沿って発達し，河川が堆積と侵食を繰り返すことで形成される階段状の地形を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["河岸段丘","海岸平野","海岸段丘","沖積平野"],"answer":"河岸段丘","acceptableAnswers":["河岸段丘"]},{"id":"geography-049","moduleId":"geography","prompt":"山地の急流が平野に出るところで，流速を減じて運搬力が衰えることにより，谷の出口を頂点に下流に向けて半円錐状の緩傾斜地が形成される。この地形を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["扇状地","扇頂","扇央","扇端"],"answer":"扇状地","acceptableAnswers":["扇状地"]},{"id":"geography-050","moduleId":"geography","prompt":"両側に山地がせまる，扇状地の最上流部を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["扇頂","扇状地","扇央","扇端"],"answer":"扇頂","acceptableAnswers":["扇頂"]},{"id":"geography-051","moduleId":"geography","prompt":"増水時以外は河川水がない水無川がみられ，水利に恵まれないため果樹園や畑に利用される，扇状地の中央部を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["扇央","扇状地","扇頂","扇端"],"answer":"扇央","acceptableAnswers":["扇央"]},{"id":"geography-052","moduleId":"geography","prompt":"伏流水が地表に湧出するため水利に恵まれ，集落が立地し水田が開かれる，扇状地の末端部を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["扇端","扇状地","扇頂","扇央"],"answer":"扇端","acceptableAnswers":["扇端"]},{"id":"geography-053","moduleId":"geography","prompt":"黄河下流部や草津川（滋賀県）のように，堆積作用が旺盛なため，堤防内の河床が周辺の土地よりも高くなってしまった河川を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["天井川","扇状地","扇頂","扇央"],"answer":"天井川","acceptableAnswers":["天井川"]},{"id":"geography-054","moduleId":"geography","prompt":"河川が左右に屈曲して，S字形を連ねたような形に流れる現象を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["蛇行","氾濫原","自然堤防","後背湿地"],"answer":"蛇行","acceptableAnswers":["蛇行"]},{"id":"geography-055","moduleId":"geography","prompt":"洪水時に河川からあふれた濁流が土砂を堆積させてつくった平坦地を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["氾濫原","蛇行","自然堤防","後背湿地"],"answer":"氾濫原","acceptableAnswers":["氾濫原","はん濫原","氾らん原"]},{"id":"geography-056","moduleId":"geography","prompt":"洪水時に河川からあふれた濁流が，急に流速を減じたため，運搬物を堆積させてできた微高地を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["自然堤防","蛇行","氾濫原","後背湿地"],"answer":"自然堤防","acceptableAnswers":["自然堤防"]},{"id":"geography-057","moduleId":"geography","prompt":"洪水時に河川からあふれた水流が，洪水後も自然堤防にさえぎられて溜ることで生じた，水はけの悪い低湿地を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["後背湿地","被圧地下水","自噴","伏流水"],"answer":"後背湿地","acceptableAnswers":["後背湿地"]},{"id":"geography-058","moduleId":"geography","prompt":"河川が海や湖にそそぐところで流速を減じ，これまで運搬されてきた細粒の土砂が堆積することで形成された低平な地形を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["三角州","円弧状三角州","鳥趾状三角州","干潟"],"answer":"三角州","acceptableAnswers":["三角州"]},{"id":"geography-059","moduleId":"geography","prompt":"ナイル川河口のように，比較的波静かな水域に形成される半円状の三角州を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["円弧状三角州","鳥趾状三角州","三角州","干潟"],"answer":"円弧状三角州","acceptableAnswers":["円弧状三角州"]},{"id":"geography-060","moduleId":"geography","prompt":"ミシシッピ川河口のように，河川によって運搬されてきた土砂の堆積が旺盛で，分岐した複数の流路に沿って自然堤防がのび，手のひら状の形態を示す三角州を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["鳥趾状三角州","円弧状三角州","三角州","干潟"],"answer":"鳥趾状三角州","acceptableAnswers":["鳥趾状三角州","鳥し状三角州","鳥足状三角州"]},{"id":"geography-062","moduleId":"geography","prompt":"不透水層にはさまれた透水層中にあり，大気圧よりも大きい圧力を受けている地下水を何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["被圧地下水","自噴","伏流水","後背湿地"],"answer":"被圧地下水","acceptableAnswers":["被圧地下水"]},{"id":"geography-063","moduleId":"geography","prompt":"不透水層を掘り抜くと，地下水に加えられている圧力により，被圧地下水が地表面よりも高い位置まで噴出してくる。これを何というか。","explanation":"","category":"河川の地形","type":"choice","choices":["自噴","被圧地下水","伏流水","後背湿地"],"answer":"自噴","acceptableAnswers":["自噴"]},{"id":"geography-064","moduleId":"geography","prompt":"波により海岸に打ち上げられた砂礫がつくる，海岸線に沿って細長くのびる微高地を何というか。","explanation":"","category":"海岸の地形","type":"choice","choices":["浜堤","砂嘴","砂州","潟湖（ラグーン）"],"answer":"浜堤","acceptableAnswers":["浜堤"]},{"id":"geography-065","moduleId":"geography","prompt":"半島の先端や岬から海に突き出した細長い堆積地形で，沿岸流の影響で先端部は内湾側に湾曲するものを何というか。","explanation":"","category":"海岸の地形","type":"choice","choices":["砂嘴","浜堤","砂州","潟湖（ラグーン）"],"answer":"砂嘴","acceptableAnswers":["砂嘴"]},{"id":"geography-066","moduleId":"geography","prompt":"沿岸流に沿って土砂が細長く堆積し，湾口をふさぐほどまで発達した地形を何というか。","explanation":"","category":"海岸の地形","type":"choice","choices":["砂州","浜堤","砂嘴","潟湖（ラグーン）"],"answer":"砂州","acceptableAnswers":["砂州"]},{"id":"geography-067","moduleId":"geography","prompt":"砂州によって湾口が部分的または全体的にふさがれ，外洋側と隔てられた水域を何というか。","explanation":"","category":"海岸の地形","type":"choice","choices":["潟湖（ラグーン）","浜堤","砂嘴","砂州"],"answer":"潟湖（ラグーン）","acceptableAnswers":["潟湖（ラグーン）","潟湖","ラグーン"]}]