[{"id":"chemistry-chem041","moduleId":"chemistry","prompt":"含まれている成分の量を調べる分析を何というか。","explanation":"「どれだけ含まれているか」を調べる。","category":"元素と検出","type":"choice","choices":["定量分析","定性分析","元素分析","炎色反応"],"answer":"定量分析","acceptableAnswers":["定量分析"]},{"id":"chemistry-chem042","moduleId":"chemistry","prompt":"炭素を含む物質を燃焼させると発生しやすい、石灰水を白くにごらせる気体は何か。","explanation":"炭素の検出に利用される。","category":"元素と検出","type":"choice","choices":["二酸化炭素","酸素","水素","窒素"],"answer":"二酸化炭素","acceptableAnswers":["二酸化炭素","CO2"]},{"id":"chemistry-chem043","moduleId":"chemistry","prompt":"二酸化炭素を通すと白くにごる液体は何か。","explanation":"二酸化炭素の検出に用いる。","category":"元素と検出","type":"choice","choices":["石灰水","塩酸","アンモニア水","エタノール"],"answer":"石灰水","acceptableAnswers":["石灰水"]},{"id":"chemistry-chem044","moduleId":"chemistry","prompt":"水の検出に使い、水で青色から赤色に変化する紙は何か。","explanation":"水の検出に使う。","category":"元素と検出","type":"choice","choices":["塩化コバルト紙","リトマス紙","ろ紙","pH試験紙"],"answer":"塩化コバルト紙","acceptableAnswers":["塩化コバルト紙"]},{"id":"chemistry-chem045","moduleId":"chemistry","prompt":"水の検出に使い、水で白色から青色に変化する物質は何か。","explanation":"無水硫酸銅は水で青色になる。","category":"元素と検出","type":"choice","choices":["硫酸銅(II)無水物","塩化銀","炭酸カルシウム","水酸化ナトリウム"],"answer":"硫酸銅(II)無水物","acceptableAnswers":["硫酸銅(II)無水物","無水硫酸銅"]},{"id":"chemistry-chem046","moduleId":"chemistry","prompt":"金属元素を炎に入れたとき、元素に特有の色が見える反応は何か。","explanation":"金属元素の検出に使う。","category":"元素と検出","type":"choice","choices":["炎色反応","沈殿反応","中和反応","分解反応"],"answer":"炎色反応","acceptableAnswers":["炎色反応"]},{"id":"chemistry-chem047","moduleId":"chemistry","prompt":"ナトリウムNaの炎色反応の色は何色か。","explanation":"Naは黄色。","category":"元素と検出","type":"choice","choices":["黄色","赤紫色","青緑色","橙赤色"],"answer":"黄色","acceptableAnswers":["黄色"]},{"id":"chemistry-chem048","moduleId":"chemistry","prompt":"カリウムKの炎色反応の代表的な色は何色か。","explanation":"Kは赤紫色系。","category":"元素と検出","type":"choice","choices":["赤紫色","黄色","青緑色","橙赤色"],"answer":"赤紫色","acceptableAnswers":["赤紫色"]},{"id":"chemistry-chem049","moduleId":"chemistry","prompt":"カルシウムCaの炎色反応の代表的な色は何色か。","explanation":"Caは橙赤色系。","category":"元素と検出","type":"choice","choices":["橙赤色","黄色","赤紫色","青緑色"],"answer":"橙赤色","acceptableAnswers":["橙赤色"]},{"id":"chemistry-chem050","moduleId":"chemistry","prompt":"銅Cuの炎色反応の代表的な色は何色か。","explanation":"Cuは青緑色系。","category":"元素と検出","type":"choice","choices":["青緑色","黄色","赤紫色","橙赤色"],"answer":"青緑色","acceptableAnswers":["青緑色"]},{"id":"chemistry-chem051","moduleId":"chemistry","prompt":"塩化物イオンを含む水溶液に硝酸銀水溶液を加えるとできる白色沈殿は何か。","explanation":"Ag+とCl-からAgClができる。","category":"元素と検出","type":"choice","choices":["塩化銀","炭酸カルシウム","硫酸バリウム","水酸化銅"],"answer":"塩化銀","acceptableAnswers":["塩化銀","AgCl"]},{"id":"chemistry-chem052","moduleId":"chemistry","prompt":"塩化銀AgClの沈殿の色は何色か。","explanation":"AgClは白色沈殿。","category":"元素と検出","type":"choice","choices":["白色","青色","赤褐色","黒色"],"answer":"白色","acceptableAnswers":["白色"]},{"id":"chemistry-chem053","moduleId":"chemistry","prompt":"二酸化炭素を石灰水に通したときにできる白色沈殿は主に何か。","explanation":"CaCO3の白色沈殿で白くにごる。","category":"元素と検出","type":"choice","choices":["炭酸カルシウム","塩化銀","硫酸銅","酸化銅"],"answer":"炭酸カルシウム","acceptableAnswers":["炭酸カルシウム","CaCO3"]},{"id":"chemistry-chem054","moduleId":"chemistry","prompt":"物質の三態は、固体・液体・何か。","explanation":"化学基礎では基本的に固体・液体・気体の三態を扱う。","category":"状態変化","type":"choice","choices":["気体","固体","液体","プラズマ"],"answer":"気体","acceptableAnswers":["気体"]},{"id":"chemistry-chem055","moduleId":"chemistry","prompt":"物質の状態が変わることを何というか。","explanation":"物質そのものは変わらず、状態だけが変わる。","category":"状態変化","type":"choice","choices":["状態変化","化学変化","中和","酸化"],"answer":"状態変化","acceptableAnswers":["状態変化"]},{"id":"chemistry-chem056","moduleId":"chemistry","prompt":"固体が液体になる変化は何か。","explanation":"氷が水になる変化。","category":"状態変化","type":"choice","choices":["融解","凝固","蒸発","凝縮"],"answer":"融解","acceptableAnswers":["融解"]},{"id":"chemistry-chem057","moduleId":"chemistry","prompt":"液体が固体になる変化は何か。","explanation":"水が氷になる変化。","category":"状態変化","type":"choice","choices":["凝固","融解","蒸発","昇華"],"answer":"凝固","acceptableAnswers":["凝固"]},{"id":"chemistry-chem058","moduleId":"chemistry","prompt":"液体が気体になる変化は何か。","explanation":"液体表面から気体になること。","category":"状態変化","type":"choice","choices":["蒸発","融解","凝固","凝縮"],"answer":"蒸発","acceptableAnswers":["蒸発"]},{"id":"chemistry-chem059","moduleId":"chemistry","prompt":"液体全体から気体が発生する現象は何か。","explanation":"沸点で液体内部からも気体が出る。","category":"状態変化","type":"choice","choices":["沸騰","蒸発","凝縮","昇華"],"answer":"沸騰","acceptableAnswers":["沸騰"]},{"id":"chemistry-chem060","moduleId":"chemistry","prompt":"気体が液体になる変化は何か。","explanation":"水蒸気が水滴になる変化。","category":"状態変化","type":"choice","choices":["凝縮","融解","凝固","蒸発"],"answer":"凝縮","acceptableAnswers":["凝縮"]}]
