[{"id":"chemistry-chem081","moduleId":"chemistry","prompt":"K殻に入る電子の最大数はいくつか。","explanation":"K殻は最大2個。","category":"電子配置と周期表","type":"choice","choices":["2個","8個","18個","32個"],"answer":"2個","acceptableAnswers":["2個"]},{"id":"chemistry-chem082","moduleId":"chemistry","prompt":"L殻に入る電子の最大数はいくつか。","explanation":"L殻は最大8個。","category":"電子配置と周期表","type":"choice","choices":["8個","2個","18個","32個"],"answer":"8個","acceptableAnswers":["8個"]},{"id":"chemistry-chem083","moduleId":"chemistry","prompt":"原子の電子が電子殻にどのように入っているかを表したものを何というか。","explanation":"例：Naは2,8,1。","category":"電子配置と周期表","type":"choice","choices":["電子配置","周期表","原子番号","質量数"],"answer":"電子配置","acceptableAnswers":["電子配置"]},{"id":"chemistry-chem084","moduleId":"chemistry","prompt":"原子の最も外側の電子殻を何というか。","explanation":"一番外側の電子殻。","category":"電子配置と周期表","type":"choice","choices":["最外殻","K殻","原子核","内殻"],"answer":"最外殻","acceptableAnswers":["最外殻"]},{"id":"chemistry-chem085","moduleId":"chemistry","prompt":"最外殻にある電子を何というか。","explanation":"化学的性質に関わりやすい。","category":"電子配置と周期表","type":"choice","choices":["価電子","陽子","中性子","核子"],"answer":"価電子","acceptableAnswers":["価電子"]},{"id":"chemistry-chem086","moduleId":"chemistry","prompt":"価電子がほぼ満たされていて安定な18族元素を何というか。","explanation":"He, Ne, Arなど。","category":"電子配置と周期表","type":"choice","choices":["希ガス","ハロゲン","アルカリ金属","半金属"],"answer":"希ガス","acceptableAnswers":["希ガス"]},{"id":"chemistry-chem087","moduleId":"chemistry","prompt":"元素を原子番号順に並べ、性質の似た元素が縦に並ぶ表は何か。","explanation":"縦の列を族、横の行を周期という。","category":"電子配置と周期表","type":"choice","choices":["周期表","電子配置","元素記号","質量数表"],"answer":"周期表","acceptableAnswers":["周期表"]},{"id":"chemistry-chem088","moduleId":"chemistry","prompt":"周期表の縦の列を何というか。","explanation":"同じ族では性質が似ることが多い。","category":"電子配置と周期表","type":"choice","choices":["族","周期","電子殻","価電子"],"answer":"族","acceptableAnswers":["族"]},{"id":"chemistry-chem089","moduleId":"chemistry","prompt":"周期表の横の行を何というか。","explanation":"周期は使っている電子殻の数と関係する。","category":"電子配置と周期表","type":"choice","choices":["周期","族","電子殻","価電子"],"answer":"周期","acceptableAnswers":["周期"]},{"id":"chemistry-chem090","moduleId":"chemistry","prompt":"1族の水素以外の元素を何というか。","explanation":"Li, Na, Kなど。","category":"電子配置と周期表","type":"choice","choices":["アルカリ金属","ハロゲン","希ガス","半金属"],"answer":"アルカリ金属","acceptableAnswers":["アルカリ金属"]},{"id":"chemistry-chem091","moduleId":"chemistry","prompt":"17族元素を何というか。","explanation":"F, Cl, Br, Iなど。","category":"電子配置と周期表","type":"choice","choices":["ハロゲン","アルカリ金属","希ガス","半金属"],"answer":"ハロゲン","acceptableAnswers":["ハロゲン"]},{"id":"chemistry-chem092","moduleId":"chemistry","prompt":"18族元素を何というか。","explanation":"He, Ne, Arなど。","category":"電子配置と周期表","type":"choice","choices":["希ガス","アルカリ金属","ハロゲン","遷移元素"],"answer":"希ガス","acceptableAnswers":["希ガス"]},{"id":"chemistry-chem093","moduleId":"chemistry","prompt":"同じ族の元素で化学的性質が似る主な理由は何か。","explanation":"価電子数が反応性に大きく関係する。","category":"電子配置と周期表","type":"choice","choices":["価電子数が同じだから","質量数が同じだから","中性子数が同じだから","融点が同じだから"],"answer":"価電子数が同じだから","acceptableAnswers":["価電子数が同じだから"]},{"id":"chemistry-chem094","moduleId":"chemistry","prompt":"Naの電子配置はどれか。","explanation":"Naは原子番号11。","category":"電子配置と周期表","type":"choice","choices":["2,8,1","2,7","2,8,7","2,8,8"],"answer":"2,8,1","acceptableAnswers":["2,8,1"]},{"id":"chemistry-chem095","moduleId":"chemistry","prompt":"Clの電子配置はどれか。","explanation":"Clは原子番号17。","category":"電子配置と周期表","type":"choice","choices":["2,8,7","2,8,1","2,6","2,8,8"],"answer":"2,8,7","acceptableAnswers":["2,8,7"]},{"id":"chemistry-chem096","moduleId":"chemistry","prompt":"Neの電子配置はどれか。","explanation":"Neは原子番号10。","category":"電子配置と周期表","type":"choice","choices":["2,8","2,1","2,4","2,8,1"],"answer":"2,8","acceptableAnswers":["2,8"]},{"id":"chemistry-chem097","moduleId":"chemistry","prompt":"原子や原子団が電子を失ったり受け取ったりして電気を帯びた粒子を何というか。","explanation":"陽イオンと陰イオンがある。","category":"イオン","type":"choice","choices":["イオン","原子","分子","同位体"],"answer":"イオン","acceptableAnswers":["イオン"]},{"id":"chemistry-chem098","moduleId":"chemistry","prompt":"電子を失って正の電気を帯びたイオンを何というか。","explanation":"電子を失うと正に帯電する。","category":"イオン","type":"choice","choices":["陽イオン","陰イオン","原子核","電子殻"],"answer":"陽イオン","acceptableAnswers":["陽イオン"]},{"id":"chemistry-chem099","moduleId":"chemistry","prompt":"電子を受け取って負の電気を帯びたイオンを何というか。","explanation":"電子を受け取ると負に帯電する。","category":"イオン","type":"choice","choices":["陰イオン","陽イオン","価電子","同位体"],"answer":"陰イオン","acceptableAnswers":["陰イオン"]},{"id":"chemistry-chem100","moduleId":"chemistry","prompt":"ナトリウム原子Naが電子を1個失うとできるイオンは何か。","explanation":"Na+になる。","category":"イオン","type":"choice","choices":["ナトリウムイオン","塩化物イオン","マグネシウムイオン","酸化物イオン"],"answer":"ナトリウムイオン","acceptableAnswers":["ナトリウムイオン","Na+"]}]