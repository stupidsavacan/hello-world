.records-tabs,.records-filters,.records-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.records-tabs{margin-bottom:10px}.records-filters{margin-bottom:10px}.records-filters input{flex:1 1 220px}.records-filters input,.records-filters select,.records-json{border:1px solid #ffffff22;border-radius:9px;padding:8px;background:#0004;color:inherit}.records-list{display:grid;gap:8px;max-height:25rem;overflow:auto}.records-card{border:1px solid #ffffff22;border-radius:10px;padding:10px;background:#ffffff08}.records-summary{display:grid;gap:3px;margin-bottom:8px}.records-tags{color:#ffd98a}.records-detail{white-space:pre-wrap;max-height:12rem;overflow:auto}.records-json{width:100%;min-height:18rem;resize:vertical;font-family:ui-monospace,monospace}.records-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}.records-metric{display:grid;border:1px solid #ffffff22;border-radius:9px;padding:8px}.records-metric span{opacity:.75}.records-status,.records-yaku{margin-top:10px}.record-empty{padding:12px;opacity:.7}@media(max-width:600px){.records-tabs button,.records-actions button,.records-filters>*{flex:1 1 100%}}
